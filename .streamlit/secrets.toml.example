# Google sign-in for the dashboard (Streamlit's st.login).
# Copy this file to .streamlit/secrets.toml (which git ignores) and fill it in.
# Without a secrets.toml, the dashboard runs without sign-in for one local user.

[auth]
# Must match an "Authorized redirect URI" on the Google OAuth client exactly
redirect_uri = "http://localhost:8501/oauth2callback"
# A long random string that signs the login cookie. Generate one with:
#   uv run python -c "import secrets; print(secrets.token_hex(32))"
cookie_secret = "paste-a-long-random-string-here"
# From Google Cloud Console > APIs & Services > Credentials > your OAuth client
client_id = "your-client-id.apps.googleusercontent.com"
client_secret = "your-client-secret"
server_metadata_url = "https://accounts.google.com/.well-known/openid-configuration"
